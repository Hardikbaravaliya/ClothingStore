@model StoreNavModel

<ul class="navbar-nav me-auto">
    @foreach (var category in Model.Categories)
    {
        if (category.Children.Count == 0)
        {
            <li class="nav-item"><a class="nav-link" href="/c/@category.Slug">@category.Name</a></li>
        }
        else
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@category.Name</a>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item fw-semibold" href="/c/@category.Slug">All @category.Name</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    @foreach (var child in category.Children)
                    {
                        <li><a class="dropdown-item" href="/c/@child.Slug">@child.Name</a></li>
                    }
                </ul>
            </li>
        }
    }
</ul>

<form class="d-flex my-2 my-lg-0 me-lg-3" role="search" action="/search" method="get">
    <input class="form-control form-control-sm" type="search" name="q" placeholder="Search" aria-label="Search" value="@Context.Request.Query["q"]" />
</form>

<ul class="navbar-nav">
    <li class="nav-item">
        <a class="nav-link" href="/cart">
            Cart
            @if (Model.CartCount > 0)
            {
                <span class="badge rounded-pill brand-bg">@Model.CartCount</span>
            }
        </a>
    </li>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity.Name</a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/orders">My orders</a></li>
                <li><a class="dropdown-item" href="/account/addresses">My addresses</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form action="/account/logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item">Logout</button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" href="/account/login">Login</a></li>
    }
</ul>
