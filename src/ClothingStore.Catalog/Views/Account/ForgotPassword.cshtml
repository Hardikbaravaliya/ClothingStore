@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="row justify-content-center">
    <div class="col-sm-9 col-md-6 col-lg-4">
        <h1 class="h4 mb-3">Forgot password</h1>
        <p class="text-muted small">Enter your email and we will send you a link to set a new password.</p>
        <form method="post" action="/account/forgot-password" asp-antiforgery="true">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-brand w-100">Send reset link</button>
        </form>
        <div class="mt-3 small"><a href="/account/login">Back to login</a></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
