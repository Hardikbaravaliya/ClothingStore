@model ResetPasswordRequest
@{
    ViewData["Title"] = "Set a new password";
}

<div class="row justify-content-center">
    <div class="col-sm-9 col-md-6 col-lg-4">
        <h1 class="h4 mb-3">Set a new password</h1>
        <form method="post" action="/account/reset-password" asp-antiforgery="true">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <p class="small text-muted">For @Model.Email</p>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-brand w-100">Save password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
