@model PagedResult<OrderSummaryDto>
@{
    ViewData["Title"] = "My orders";
}

<h1 class="h4 mb-3">My orders</h1>

@if (Model.TotalCount == 0)
{
    <p class="text-muted">You have no orders yet.</p>
    <a href="/" class="btn btn-brand">Start shopping</a>
}
else
{
    <div class="list-group mb-3">
        @foreach (var o in Model.Items)
        {
            <a href="/orders/@o.OrderNo" class="list-group-item list-group-item-action d-flex flex-wrap justify-content-between gap-2">
                <span>
                    <strong>@o.OrderNo</strong>
                    <span class="text-muted small ms-2">@Shop.ToLocal(o.CreatedAtUtc).ToString("dd MMM yyyy")</span>
                    <span class="d-block small text-muted">@o.ItemCount item(s) · @(o.PaymentMethod == PaymentMethods.Cod ? "Cash on delivery" : "Online")</span>
                </span>
                <span class="text-end">
                    <span class="fw-semibold d-block">@Shop.Money(o.TotalAmount)</span>
                    <partial name="_OrderStatusBadge" model="o.Status" />
                </span>
            </a>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Pages">
            <ul class="pagination">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="/orders?page=@p">@p</a></li>
                }
            </ul>
        </nav>
    }
}
