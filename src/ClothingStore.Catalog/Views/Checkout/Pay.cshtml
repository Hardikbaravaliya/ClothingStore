@model RazorpayCheckoutDto
@{
    ViewData["Title"] = "Payment";
    var orderNo = (string)ViewBag.OrderNo;
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5 text-center">
        <h1 class="h4 mb-2">Complete your payment</h1>
        <p class="text-muted">Order <strong>@orderNo</strong> · @Shop.Money(Model.AmountInPaise / 100m)</p>
        <p id="pay-status" class="small text-muted">Opening the secure payment window…</p>
        <button type="button" id="pay-button" class="btn btn-brand btn-lg">Pay now</button>
        <div class="mt-3 small"><a href="/orders/@orderNo">View order</a></div>
    </div>
</div>

@* Filled by the Razorpay success handler; the Api verifies the signature *@
<form id="verify-form" method="post" action="/checkout/verify" asp-antiforgery="true" class="d-none">
    <input type="hidden" name="orderNo" value="@orderNo" />
    <input type="hidden" name="razorpay_order_id" />
    <input type="hidden" name="razorpay_payment_id" />
    <input type="hidden" name="razorpay_signature" />
</form>

@section Scripts {
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        (function () {
            var data = @Json.Serialize(new
            {
                key = Model.KeyId,
                amount = Model.AmountInPaise,
                currency = Model.Currency,
                name = Model.StoreName,
                order_id = Model.RazorpayOrderId,
                description = "Order " + orderNo,
                prefill = new { name = Model.CustomerName, email = Model.CustomerEmail, contact = Model.CustomerPhone ?? "" },
                theme = new { color = (string?)ViewBag.ThemeColor ?? "#d63384" },
            });
            var status = document.getElementById('pay-status');
            var form = document.getElementById('verify-form');

            data.handler = function (response) {
                status.textContent = 'Payment received. Confirming your order…';
                form.elements['razorpay_order_id'].value = response.razorpay_order_id;
                form.elements['razorpay_payment_id'].value = response.razorpay_payment_id;
                form.elements['razorpay_signature'].value = response.razorpay_signature;
                form.submit();
            };
            data.modal = {
                ondismiss: function () { status.textContent = 'Payment was not completed. You can try again.'; }
            };

            function open() {
                if (typeof Razorpay === 'undefined') {
                    status.textContent = 'Could not load the payment window. Check your internet connection and try again.';
                    return;
                }
                var rzp = new Razorpay(data);
                rzp.on('payment.failed', function (r) {
                    status.textContent = 'Payment failed: ' + (r.error && r.error.description ? r.error.description : 'please try again.');
                });
                rzp.open();
            }

            document.getElementById('pay-button').addEventListener('click', open);
            open();
        })();
    </script>
}
