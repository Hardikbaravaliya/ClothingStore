@model PagedList<PurchaseListItem>
@{
    ViewData["Title"] = "Purchases";
    var query = (PurchaseQuery)ViewBag.Query;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Purchases</h1>
    <a asp-action="Create" asp-route-supplierId="@query.SupplierId" class="btn btn-primary">New purchase</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-4">
        <select name="supplierId" asp-items="ViewBag.Suppliers" class="form-select">
            <option value="">All suppliers</option>
        </select>
    </div>
    <div class="col-sm-3">
        <input type="date" name="from" value="@query.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="From date" />
    </div>
    <div class="col-sm-3">
        <input type="date" name="to" value="@query.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="To date" />
    </div>
    <div class="col-sm-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info">No purchases found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Invoice no</th>
                    <th class="text-end">Items</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@p.Id">@Clock.ToLocal(p.PurchaseDate).ToString("dd-MM-yyyy")</a></td>
                        <td>@p.SupplierName</td>
                        <td>@p.InvoiceNo</td>
                        <td class="text-end">@p.ItemCount</td>
                        <td class="text-end">@p.TotalQuantity</td>
                        <td class="text-end">@Money.Format(p.TotalAmount)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model" />
}
