@model StockLedger
@{
    var v = Model.Variant;
    ViewData["Title"] = "Stock ledger";
}

<a asp-action="Index" class="small">← Stock</a>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">@v.ProductName</h1>
        <span class="text-muted">@v.Size / @v.Color · @v.Sku</span>
    </div>
    <div class="text-end">
        <div class="fs-4 fw-semibold @(v.IsLowStock ? "text-danger" : "")">@v.StockQty in stock</div>
        <div class="text-muted small">Avg cost @Money.Format(v.AvgCostPrice)</div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold">Adjust stock (after a physical count)</div>
    <div class="card-body">
        <form asp-action="Adjust" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="VariantId" value="@v.VariantId" />
            <div class="col-sm-3">
                <label class="form-label small" for="NewQuantity">Actual quantity</label>
                <input id="NewQuantity" name="NewQuantity" type="number" min="0" value="@v.StockQty" class="form-control" required />
            </div>
            <div class="col-sm-6">
                <label class="form-label small" for="Reason">Reason</label>
                <input id="Reason" name="Reason" maxlength="500" class="form-control" placeholder="e.g. Damaged piece, stock count" required />
            </div>
            <div class="col-sm-3">
                <button type="submit" class="btn btn-outline-primary w-100">Adjust</button>
            </div>
        </form>
    </div>
</div>

<h2 class="h5">Ledger</h2>
@if (Model.Entries.TotalCount == 0)
{
    <div class="alert alert-info">No stock movements yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th class="text-end">Change</th>
                    <th class="text-end">Balance</th>
                    <th class="text-end">Unit cost</th>
                    <th>Reference</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Entries.Items)
                {
                    <tr>
                        <td class="text-nowrap">@Clock.ToLocal(e.CreatedAt).ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@e.Type</td>
                        <td class="text-end @(e.Quantity < 0 ? "text-danger" : "text-success")">@(e.Quantity > 0 ? "+" : "")@e.Quantity</td>
                        <td class="text-end">@e.BalanceAfter</td>
                        <td class="text-end">@(e.UnitCost is { } cost ? Money.Format(cost) : "")</td>
                        <td>
                            @if (e.ReferenceType == "Purchase" && e.ReferenceId is { } purchaseId)
                            {
                                <a asp-controller="Purchases" asp-action="Details" asp-route-id="@purchaseId">Purchase #@purchaseId</a>
                            }
                            else
                            {
                                @e.ReferenceType
                            }
                        </td>
                        <td class="small">@e.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Entries" />
}
